{
  "name": "tinnitus-notch",
  "version": "0.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "preview": "pnpm run build && wrangler dev",
    "format": "oxfmt src package.json playwright.config.ts tsconfig.json vite.config.ts vitest.config.ts wrangler.jsonc",
    "format:check": "oxfmt --check src package.json playwright.config.ts tsconfig.json vite.config.ts vitest.config.ts wrangler.jsonc",
    "lint": "oxlint src tests vite.config.ts vitest.config.ts playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke"
  },
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@solidjs/vite-plugin": "^3.0.0-next.28",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.124.0"
  },
  "dependencies": {
    "@kobalte/core": "^2.0.0-alpha.0",
    "@solid-primitives/selection": "^1.0.0-next.2",
    "@solidjs/router": "^2.0.0-next.16",
    "@solidjs/web": "^2.0.0-rc.0",
    "class-variance-authority": "^0.7.1",
    "cnfast": "^0.1.0",
    "solid-js": "^2.0.0-rc.0",
    "tw-animate-css": "^1.4.0"
  }
}
